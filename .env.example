# GitHub personal access token for sync:github script
# See scripts/SCRIPTS.md for instructions on creating one
GITHUB_TOKEN=YOUR_TOKEN_HERE

# CV contact details — used ONLY to render a CV with contact info locally
# (`npm run render:cv:contact`). Put the real values in .env.local (gitignored).
# The deployed site and the public cv.pdf/cv.json never include these.
VITE_CV_EMAIL=you@example.com
VITE_CV_PHONE=00000 000000
